#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────
# herdr-nav-tabs — the tab sub-list under each space, in the navigator
# (prefix+w).
#
# WHY A SCRIPT
# herdr-navigator has no "tab" source: its sources are workspace, agent,
# session, server, project, zoxide, root, quick, plugin. No tree view
# either, it's a flat picker. The only extension point is [[integrations]]:
# a `collect` command that prints a JSON array, an `open` command run on
# the selection.
#
# OBSOLETE. The integration is disabled in config.toml.
# The tree view is now NATIVE (picker.tab_children), through a plugin
# patch: see ~/.config/herdr/patches/.
#
# Kept as a fallback: if the patch stops applying after a plugin update,
# set enabled = true again and tabs show up in a separate "tabs" section.
#
# WHAT YOU GET
# One entry per tab, titled "<space> › <tab>". The space name is IN the
# title, so typing it brings up the space and all its tabs together.
#
# HEADS UP: kind = "workspace" does NOT group the entry with the spaces.
# The plugin only reads `kind` for "server"/"remote-terminal" ->
# Source::Server and "session" -> Source::Session. Everything else lands
# in Source::Integration. No path leads to the "open" section, which is
# exactly why the native patch exists.
#
# Spaces with a SINGLE tab are skipped: that tab would just duplicate the
# space line. Set SHOW_SINGLE=1 to include them anyway.
#
# Sessions are NOT nested here, on purpose: a session is a separate herdr
# server, not a child of a space. It has its own filter, Ctrl-L.
# ─────────────────────────────────────────────────────────────────────
set -uo pipefail

PY=$(command -v python3.13 || command -v /opt/homebrew/bin/python3 || command -v python3)

if [[ -z ${HERDR_SOCKET_PATH:-} ]]; then
  s="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/herdr.sock"
  [[ -S $s ]] && export HERDR_SOCKET_PATH="$s"
fi

WS=$(herdr workspace list 2>/dev/null)
TABS=$(herdr tab list 2>/dev/null)

# Server missing or silent: empty array, never an error. The navigator
# would show the error message as an entry.
[[ -n $WS && -n $TABS ]] || { echo "[]"; exit 0; }

WS="$WS" TABS="$TABS" SHOW_SINGLE="${SHOW_SINGLE:-0}" "$PY" - <<'PYEOF'
import json, os, re, sys

def unwrap(raw, key):
    """CLI commands return {"result": {...}}, some return the payload at
    the root. Accept both, a silent exception here would empty the list
    without a word."""
    try:
        d = json.loads(raw)
    except Exception:
        return []
    return d.get("result", {}).get(key) or d.get(key) or []

workspaces = unwrap(os.environ.get("WS", ""), "workspaces")
tabs       = unwrap(os.environ.get("TABS", ""), "tabs")
show_single = os.environ.get("SHOW_SINGLE") == "1"

# herdr prefixes labels with the display number: "[2] zsh". The number is
# already in the `number` field, so strip it from the text to avoid
# "[3] project › [2] run".
NUM = re.compile(r"^\s*\[\d+\]\s*")
def clean(label, fallback=""):
    return NUM.sub("", (label or "").strip()) or fallback

# Agent state -> dot. Only states that NEED you get a mark. "unknown" and
# "idle" stay quiet to keep the noise down.
DOT = {
    "working":   "◐",
    "blocked":   "●",
    "attention": "●",
    "request":   "●",
    "error":     "✖",
    "done":      "✓",
}

by_ws = {}
for t in tabs:
    by_ws.setdefault(t.get("workspace_id"), []).append(t)

items = []
for w in sorted(workspaces, key=lambda x: x.get("number", 0)):
    wid   = w.get("workspace_id")
    wname = clean(w.get("label"), wid or "?")
    kids  = sorted(by_ws.get(wid, []), key=lambda x: x.get("number", 0))

    if len(kids) <= 1 and not show_single:
        continue

    for t in kids:
        tname = clean(t.get("label"), "tab")
        dot   = DOT.get(t.get("agent_status") or "", "")
        panes = t.get("pane_count") or 1

        # Space name goes in the TITLE, not just the subtitle: the matcher
        # indexes the title, so that's what pulls tabs up with their space.
        title = f"{wname} › {tname}"
        if dot:
            title = f"{title}  {dot}"

        bits = [f"tab {t.get('number', '?')}"]
        if panes > 1:
            bits.append(f"{panes} panes")
        if t.get("focused"):
            bits.append("courant")

        items.append({
            "id":       t.get("tab_id", ""),
            "title":    title,
            "subtitle": " · ".join(bits),
            "path":     wid or "",
            # Group with the spaces: Ctrl-W then shows both levels, space
            # then its tabs.
            "kind":     "workspace",
        })

print(json.dumps(items, ensure_ascii=False))
PYEOF
