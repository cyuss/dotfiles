#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────
# make-target-info <target> — what a make target does, before running it.
#
# fzf-tab preview: `make <TAB>` lists targets, this shows the description
# and the recipe on the right.
#
# My Makefiles use the self-documenting `target: ## description` pattern
# (checked on a real repo), so the description comes from that line and
# the recipe from the lines below it.
# ─────────────────────────────────────────────────────────────────────
set -uo pipefail
t="${1:-}"
[[ -n $t ]] || exit 0

mk=""
for f in Makefile makefile GNUmakefile; do [[ -f $f ]] && { mk="$f"; break; }; done
[[ -n $mk ]] || { echo "aucun Makefile ici"; exit 0; }

b()  { printf '\033[1m%s\033[0m\n' "$1"; }
dim(){ printf '\033[2m%s\033[0m\n' "$1"; }
amb(){ printf '\033[33m%s\033[0m\n' "$1"; }

desc=$(grep -hE "^${t}:.*##" $mk $(grep -hoE '^include .*' $mk 2>/dev/null | cut -d' ' -f2-) 2>/dev/null \
       | head -1 | sed 's/.*## *//')
[[ -n $desc ]] && { amb "$desc"; echo; }

# The recipe: from the target line down to the first line that starts
# with neither a tab nor a comment.
awk -v t="$t" '
  $0 ~ "^"t":" { inr=1; print; next }
  inr && /^\t/  { print; next }
  inr && /^#/   { next }
  inr           { exit }
' $mk | sed 's/^\t/  /' | head -30

# Variables used by the recipe, with their actual value.
vars=$(awk -v t="$t" '$0 ~ "^"t":" {inr=1;next} inr && /^\t/ {print} inr && !/^\t/ {exit}' $mk \
       | grep -oE '\$\(([A-Z_][A-Z0-9_]*)\)' | tr -d '$()' | sort -u)
if [[ -n $vars ]]; then
  echo; dim "── variables ──"
  while IFS= read -r v; do
    [[ -n $v ]] || continue
    val=$(make -pn 2>/dev/null | grep -E "^${v} [:?]?= " | head -1 | sed 's/^[^=]*= *//')
    printf '  \033[2m%-14s\033[0m %s\n' "$v" "${val:-—}"
  done <<< "$vars"
fi
