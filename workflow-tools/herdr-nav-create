#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────
# herdr-nav-create — the navigator's "create" source (prefix+w).
#
# Prints a JSON array of entries that herdr-navigator shows next to
# spaces, sessions and agents. Each entry has:
#   id       the herdr-new subcommand to run
#   path     its argument (directory, or session name)
#   kind     "session" -> entry goes with the sessions (Ctrl-L),
#            empty     -> it goes with the integrations (end of list)
#
# Sessions that already exist are NOT offered: the navigator's native
# source already lists them, with direct attach.
#
# Editable presets: ~/.config/workflow-tools/herdr-session-presets
# (one name per line, # for comments).
# ─────────────────────────────────────────────────────────────────────
set -uo pipefail

PY=$(command -v python3.13 || command -v /opt/homebrew/bin/python3 || command -v python3)
PRESET_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/workflow-tools/herdr-session-presets"

if [[ -z ${HERDR_SOCKET_PATH:-} ]]; then
  s="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/herdr.sock"
  [[ -S $s ]] && export HERDR_SOCKET_PATH="$s"
fi

# Focused pane's directory: the "here" in "new space here".
CWD=$(herdr pane current 2>/dev/null | "$PY" -c '
import json, sys
try: print(json.load(sys.stdin)["result"]["pane"]["cwd"])
except Exception: print("")
' 2>/dev/null)
[[ -n ${CWD:-} ]] || CWD="$HOME"

# `herdr session list --json` returns {"sessions": [...]} at the ROOT, no
# {"result": ...} wrapper like the other commands. Accept both: a silent
# exception here used to empty the list, and every session got offered
# for creation again, even the ones already running.
EXISTING=$(herdr session list --json 2>/dev/null | "$PY" -c '
import json, sys
try:
    d = json.load(sys.stdin)
    sessions = d.get("sessions") or d.get("result", {}).get("sessions") or []
    print(" ".join(s["name"] for s in sessions))
except Exception:
    print("")
' 2>/dev/null)

PRESETS="perso"
[[ -r $PRESET_FILE ]] && PRESETS=$(grep -vE '^\s*(#|$)' "$PRESET_FILE" | tr '\n' ' ')

CWD="$CWD" EXISTING="${EXISTING:-}" PRESETS="$PRESETS" "$PY" - <<'PYEOF'
import json, os

cwd      = os.environ["CWD"]
home     = os.path.expanduser("~")
existing = set(os.environ.get("EXISTING", "").split())
presets  = [p for p in os.environ.get("PRESETS", "").split() if p]

short = cwd.replace(home, "~", 1) if cwd.startswith(home) else cwd
items = [
    {"id": "scratch", "title": "⚡ scratch — space jetable",
     "subtitle": "shell + opencode dans ~/scratch/<horodatage>",
     "path": home, "kind": ""},
    {"id": "space", "title": "+ space ici",
     "subtitle": short, "path": cwd, "kind": ""},
    # Rename / close / delete: herdr does it for the CURRENT space
    # (prefix+/ and prefix+') and Ctrl-X closes the selected line's one,
    # but nothing renames another space or handles sessions. These two
    # entries open a dedicated picker.
    {"id": "manage-space", "title": "✎ gérer un space",
     "subtitle": "renommer ou fermer", "path": home, "kind": ""},
    {"id": "manage-session", "title": "✎ gérer une session",
     "subtitle": "renommer ou supprimer", "path": home, "kind": ""},
]

# A session isn't created in a pane: it's a separate server, so it gets
# its own Alacritty window. Only offer the missing ones.
#
# kind = "" and not "session": these live under Ctrl-N with the other
# create entries, not under Ctrl-S with existing sessions. Mixing
# "create" and "attach" entries meant reading every line to tell them
# apart. Ctrl-S = go there, Ctrl-N = make it.
for name in presets:
    if name in existing:
        continue
    items.append({"id": "session", "title": f"+ session {name}",
                  "subtitle": "nouvelle fenêtre Alacritty",
                  "path": name, "kind": ""})

print(json.dumps(items, ensure_ascii=False))
PYEOF
