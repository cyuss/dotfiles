#!/usr/bin/env bash
set -euo pipefail

PLIST="${HOME}/Library/LaunchAgents/com.lwouis.alt-tab-macos.plist"
GUI="gui/$(id -u)"
LABEL="com.lwouis.alt-tab-macos"

is_running() {
  pgrep -x AltTab >/dev/null 2>&1
}

start_alt() {
  if is_running; then
    echo "AltTab is already running"
    return 0
  fi

  if [[ -f "$PLIST" ]]; then
    launchctl bootstrap "$GUI" "$PLIST" >/dev/null 2>&1 || true
    launchctl kickstart -k "$GUI/$LABEL" >/dev/null 2>&1 || true
  fi

  sleep 0.5
  if is_running; then
    echo "AltTab started"
    return 0
  fi

  open -a AltTab >/dev/null 2>&1 || true
  sleep 0.5
  if is_running; then
    echo "AltTab started"
    return 0
  fi

  echo "Failed to start AltTab" >&2
  exit 1
}

stop_alt() {
  launchctl bootout "$GUI/$LABEL" >/dev/null 2>&1 || true
  pkill -x AltTab 2>/dev/null || true
  echo "AltTab stopped"
}

status_alt() {
  if is_running; then
    echo "AltTab: running"
  else
    echo "AltTab: stopped"
    exit 1
  fi
}

case "${1:-}" in
  start) start_alt ;;
  stop) stop_alt ;;
  restart) stop_alt || true; start_alt ;;
  status) status_alt ;;
  *) echo "Usage: $(basename "$0") {start|stop|restart|status}"; exit 2 ;;
esac
