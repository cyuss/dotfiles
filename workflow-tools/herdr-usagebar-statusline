#!/usr/bin/env python3
# ─────────────────────────────────────────────────────────────────────
# herdr-usagebar-statusline — pont entre Claude Code et la sidebar herdr.
#
# Claude Code appelle sa commande `statusLine` a chaque rendu, en lui
# passant sur stdin un JSON qui contient deux choses qu'on ne trouve
# NULLE PART ailleurs :
#
#   rate_limits            -> sans quoi usagebar ne peut pas remplir $limit
#   model.display_name     -> le modele reellement en cours ("Opus 5")
#
# Ce script fait donc deux passes sur la meme entree :
#   1. publie $model comme jeton de pane, pour la sidebar herdr ;
#   2. transmet le JSON brut, INTACT, au script du plugin usagebar.
#
# Le chemin du plugin contient un hash (usagebar-33803b79d616) : on le
# resout a l'appel, pour ne pas casser au prochain reinstall.
#
# CONTRAT d'une commande statusLine : rapide, et JAMAIS bruyante. Elle est
# rappelee a chaque rendu et sa sortie s'affiche a la place du statut.
# D'ou : aucune sortie, et exit 0 quoi qu'il arrive.
# ─────────────────────────────────────────────────────────────────────
import glob
import json
import os
import subprocess
import sys

TTL_MS = 86_400_000


def publish_model(payload):
    """$model : le modele en cours, pour la ligne 2 du panneau des agents."""
    pane = os.environ.get("HERDR_PANE_ID")
    if not pane or not os.environ.get("HERDR_SOCKET_PATH"):
        return
    name = (payload.get("model") or {}).get("display_name")
    if not isinstance(name, str) or not name.strip():
        return
    subprocess.run(
        ["herdr", "pane", "report-metadata", pane,
         "--source", "herdr-usagebar-statusline",
         "--token", f"model={name.strip()}", "--ttl-ms", str(TTL_MS)],
        timeout=3, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


def forward(raw):
    """Le plugin usagebar veut le JSON tel quel : on ne le reserialise pas."""
    hits = glob.glob(os.path.expanduser(
        "~/.config/herdr/plugins/github/usagebar-*/bin/run-statusline.sh"))
    if not hits:
        return
    subprocess.run(["bash", hits[0]], input=raw.encode("utf-8"),
                   timeout=10, stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL)


def main():
    raw = sys.stdin.read()
    try:
        payload = json.loads(raw)
    except Exception:
        payload = None
    if isinstance(payload, dict):
        try:
            publish_model(payload)
        except Exception:
            pass
    try:
        forward(raw)
    except Exception:
        pass


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
