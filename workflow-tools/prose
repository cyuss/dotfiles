#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────
# prose — relire un texte : grammaire, accords, style.
#
#   prose fichier.md          verifie (francais par defaut)
#   prose -e fichier.md       en anglais
#   prose -s fichier.md       + regles de STYLE (vale), en plus de la
#                             grammaire — anglais uniquement
#   prose README.md doc.md    plusieurs fichiers
#   git diff | prose -        depuis un tuyau
#   prose -a texte.md         TOUT activer (texte litteraire) : par defaut
#                             les regles inadaptees a la doc technique sont
#                             desactivees — chiffres a ecrire en lettres,
#                             espaces insecables, « fautes de frappe » sur
#                             les identifiants de code.
#
# Deux moteurs, et ils ne font pas la meme chose :
#
#   LanguageTool  grammaire, accords, conjugaison, typographie. Il
#                 comprend REELLEMENT le francais — subjonctif, accord
#                 du determinant, « a » vs « a ». C'est le moteur par
#                 defaut. Tourne en local (Java), rien n'est envoye.
#
#   vale          regles de STYLE (voix passive, tournures lourdes,
#                 mots vides). Ses jeux de regles sont anglophones :
#                 on ne l'active qu'avec -s, et seulement en anglais,
#                 plutot que de faire croire a une couverture francaise
#                 qui n'existe pas.
#
# Premier lancement : LanguageTool charge son modele de langue, comptez
# quelques secondes. Les suivants sont rapides.
# ─────────────────────────────────────────────────────────────────────
set -uo pipefail

LANG_CODE=fr
STYLE=0
TECH=1          # par defaut on ecrit de la doc technique, pas un roman
files=()

# Regles qui n'ont aucun sens dans de la documentation technique :
#   TYPOGRAPHIE_*     chiffres a ecrire en lettres — faux dans un tableau
#   FRENCH_WHITESPACE espace insecable avant : ; ! ? — le markdown s'en moque
#   MORFOLOGIK_*      « faute de frappe » sur les identifiants (count, len...)
#   UPPERCASE_SENTENCE_START  les titres et les listes commencent souvent bas
# Identifiants releves sur un vrai fichier (languagetool --json | .rule.id) :
#   FR_SPELLING_RULE  46 fois sur docs/README.md, uniquement sur « doom »,
#                     « herdr », « aerospace »... : le dictionnaire francais
#                     ne connait pas les noms d'outils.
#   MOT_TRAIT_MOT      9 fois : « doom-reference » n'est pas un mot compose.
#   APOS_INCORRECT    11 fois : l'apostrophe droite ' des extraits de code.
TECH_RULES_FR="FR_SPELLING_RULE,MOT_TRAIT_MOT,APOS_INCORRECT,FRENCH_WHITESPACE,WHITESPACE_RULE,NOMBRES_EN_LETTRES,NOMBRES_EN_LETTRES_2,UPPERCASE_SENTENCE_START"
TECH_RULES_EN="MORFOLOGIK_RULE_EN_US,UPPERCASE_SENTENCE_START,COMMA_PARENTHESIS_WHITESPACE,WHITESPACE_RULE,EN_QUOTES"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -e|--en|--english) LANG_CODE=en-US; shift ;;
    -f|--fr|--french)  LANG_CODE=fr;    shift ;;
    -s|--style)        STYLE=1;         shift ;;
    -a|--all|--prose)  TECH=0;          shift ;;   # texte litteraire : tout activer
    -h|--help)         sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)                 files+=("$1");   shift ;;
  esac
done

[[ ${#files[@]} -eq 0 ]] && { echo "prose: indique au moins un fichier (ou -)" >&2; exit 1; }

DISABLED=""
if [[ $TECH -eq 1 ]]; then
  if [[ $LANG_CODE == fr ]]; then DISABLED="--disable $TECH_RULES_FR"
  else                            DISABLED="--disable $TECH_RULES_EN"; fi
fi

# Depuis un tuyau : LanguageTool veut un fichier, on lui en fabrique un.
tmp=""
if [[ ${files[0]} == "-" ]]; then
  tmp=$(mktemp -t prose).md
  cat > "$tmp"
  files=("$tmp")
fi
cleanup() { [[ -n $tmp ]] && rm -f "$tmp"; }
trap cleanup EXIT

# ── Grammaire ────────────────────────────────────────────────────────
found=0
for f in "${files[@]}"; do
  [[ -r $f ]] || { echo "prose: illisible : $f" >&2; continue; }

  out=$(languagetool -l "$LANG_CODE" $DISABLED --json "$f" 2>/dev/null \
        | LT_FILE="$f" python3 -c '
import sys, json, os, bisect
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
matches = data.get("matches", [])
if not matches:
    sys.exit(0)

# LanguageTool ne donne pas le numero de ligne, seulement un OFFSET dans
# le document. On reconstruit la table des debuts de ligne une seule fois,
# puis chaque offset se resout par dichotomie.
starts = [0]
try:
    with open(os.environ["LT_FILE"], encoding="utf-8", errors="replace") as fh:
        for i, ch in enumerate(fh.read()):
            if ch == "\n":
                starts.append(i + 1)
except Exception:
    starts = None

def lineno(off):
    if not starts:
        return "?"
    return bisect.bisect_right(starts, off)

# Couleurs seulement si la sortie est un terminal.
tty = sys.stderr.isatty()
C = (lambda s, c: f"\033[{c}m{s}\033[0m") if tty else (lambda s, c: s)
for m in matches:
    ctx  = m["context"]
    frag = ctx["text"][ctx["offset"]:ctx["offset"] + ctx["length"]]
    line = lineno(m.get("offset", 0))
    sugg = ", ".join(r["value"] for r in m.get("replacements", [])[:3])
    print(f'"'"'  {C(f"L{line}", "2")}  {C(frag, "31")}'"'"'
          + (f'"'"'  ->  {C(sugg, "32")}'"'"' if sugg else "")
          + f'"'"'\n      {C(m["message"], "2")}'"'"')
print(f"__COUNT__{len(matches)}")
')
  n=$(sed -n 's/^__COUNT__//p' <<<"$out")
  body=$(grep -v '^__COUNT__' <<<"$out")

  if [[ -n ${n:-} && $n -gt 0 ]]; then
    found=1
    printf '\n\033[1m%s\033[0m  \033[2m(%s remarque%s, %s)\033[0m\n' \
      "$f" "$n" "$([[ $n -gt 1 ]] && echo s)" "$LANG_CODE"
    printf '%s\n' "$body"
  fi
done

# ── Style (anglais seulement) ────────────────────────────────────────
if [[ $STYLE -eq 1 ]]; then
  if [[ $LANG_CODE == fr ]]; then
    printf '\n\033[33m--style ignore\033[0m : les jeux de regles de vale sont anglophones.\n'
    printf '  Relance avec  \033[1mprose -e -s\033[0m  sur un texte en anglais.\n'
  elif command -v vale >/dev/null 2>&1; then
    printf '\n\033[1mStyle\033[0m \033[2m(vale)\033[0m\n'
    vale "${files[@]}" 2>&1 | sed 's/^/  /'
  fi
fi

[[ $found -eq 0 ]] && printf '\033[32m  rien a signaler\033[0m\n'
exit 0
