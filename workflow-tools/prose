#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────
# prose — proofread a text: grammar, agreement, style.
#
#   prose file.md             check it (French by default)
#   prose -e file.md          in English
#   prose -s file.md          + STYLE rules (vale) on top of grammar,
#                             English only
#   prose README.md doc.md    several files
#   git diff | prose -        from a pipe
#   prose -a text.md          turn EVERYTHING on (literary text). By
#                             default the rules that make no sense for
#                             tech docs are off: numbers spelled out,
#                             non-breaking spaces, "typos" on code
#                             identifiers.
#
# Two engines, and they don't do the same job:
#
#   LanguageTool  grammar, agreement, conjugation, typography. It
#                 actually understands French (subjunctive, article
#                 agreement, "a" vs "à"). Default engine. Runs
#                 locally (Java), nothing is sent anywhere.
#
#   vale          STYLE rules (passive voice, clunky phrasing, filler
#                 words). Its rule sets are English-only, so it only
#                 runs with -s and only in English, instead of
#                 pretending to cover French when it doesn't.
#
# First run: LanguageTool loads its language model, give it a few
# seconds. Later runs are fast.
# ─────────────────────────────────────────────────────────────────────
set -uo pipefail

LANG_CODE=fr
STYLE=0
TECH=1          # by default I write tech docs, not a novel
files=()

# Rules that make no sense for tech docs:
#   TYPOGRAPHIE_*     spell out numbers (wrong in a table)
#   FRENCH_WHITESPACE non-breaking space before : ; ! ? (markdown doesn't care)
#   MORFOLOGIK_*      "typos" on identifiers (count, len...)
#   UPPERCASE_SENTENCE_START  headings and list items often start lowercase
# IDs taken from a real file (languagetool --json | .rule.id):
#   FR_SPELLING_RULE  46 hits on docs/README.md, all on "doom", "herdr",
#                     "aerospace"...: the French dictionary doesn't know
#                     tool names.
#   MOT_TRAIT_MOT      9 hits: "doom-reference" isn't a compound word.
#   APOS_INCORRECT    11 hits: the straight ' in code snippets.
TECH_RULES_FR="FR_SPELLING_RULE,MOT_TRAIT_MOT,APOS_INCORRECT,FRENCH_WHITESPACE,WHITESPACE_RULE,NOMBRES_EN_LETTRES,NOMBRES_EN_LETTRES_2,UPPERCASE_SENTENCE_START"
TECH_RULES_EN="MORFOLOGIK_RULE_EN_US,UPPERCASE_SENTENCE_START,COMMA_PARENTHESIS_WHITESPACE,WHITESPACE_RULE,EN_QUOTES"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -e|--en|--english) LANG_CODE=en-US; shift ;;
    -f|--fr|--french)  LANG_CODE=fr;    shift ;;
    -s|--style)        STYLE=1;         shift ;;
    -a|--all|--prose)  TECH=0;          shift ;;   # literary text: turn everything on
    -h|--help)         sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)                 files+=("$1");   shift ;;
  esac
done

[[ ${#files[@]} -eq 0 ]] && { echo "prose: indique au moins un fichier (ou -)" >&2; exit 1; }

DISABLED=""
if [[ $TECH -eq 1 ]]; then
  if [[ $LANG_CODE == fr ]]; then DISABLED="--disable $TECH_RULES_FR"
  else                            DISABLED="--disable $TECH_RULES_EN"; fi
fi

# From a pipe: LanguageTool wants a file, so make one.
tmp=""
if [[ ${files[0]} == "-" ]]; then
  tmp=$(mktemp -t prose).md
  cat > "$tmp"
  files=("$tmp")
fi
cleanup() { [[ -n $tmp ]] && rm -f "$tmp"; }
trap cleanup EXIT

# ── Grammar ──────────────────────────────────────────────────────────
found=0
for f in "${files[@]}"; do
  [[ -r $f ]] || { echo "prose: illisible : $f" >&2; continue; }

  out=$(languagetool -l "$LANG_CODE" $DISABLED --json "$f" 2>/dev/null \
        | LT_FILE="$f" python3 -c '
import sys, json, os, bisect
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
matches = data.get("matches", [])
if not matches:
    sys.exit(0)

# LanguageTool gives no line number, only an OFFSET into the document.
# Build the table of line starts once, then bisect each offset.
starts = [0]
try:
    with open(os.environ["LT_FILE"], encoding="utf-8", errors="replace") as fh:
        for i, ch in enumerate(fh.read()):
            if ch == "\n":
                starts.append(i + 1)
except Exception:
    starts = None

def lineno(off):
    if not starts:
        return "?"
    return bisect.bisect_right(starts, off)

# Colors only when output is a terminal.
tty = sys.stderr.isatty()
C = (lambda s, c: f"\033[{c}m{s}\033[0m") if tty else (lambda s, c: s)
for m in matches:
    ctx  = m["context"]
    frag = ctx["text"][ctx["offset"]:ctx["offset"] + ctx["length"]]
    line = lineno(m.get("offset", 0))
    sugg = ", ".join(r["value"] for r in m.get("replacements", [])[:3])
    print(f'"'"'  {C(f"L{line}", "2")}  {C(frag, "31")}'"'"'
          + (f'"'"'  ->  {C(sugg, "32")}'"'"' if sugg else "")
          + f'"'"'\n      {C(m["message"], "2")}'"'"')
print(f"__COUNT__{len(matches)}")
')
  n=$(sed -n 's/^__COUNT__//p' <<<"$out")
  body=$(grep -v '^__COUNT__' <<<"$out")

  if [[ -n ${n:-} && $n -gt 0 ]]; then
    found=1
    printf '\n\033[1m%s\033[0m  \033[2m(%s remarque%s, %s)\033[0m\n' \
      "$f" "$n" "$([[ $n -gt 1 ]] && echo s)" "$LANG_CODE"
    printf '%s\n' "$body"
  fi
done

# ── Style (English only) ─────────────────────────────────────────────
if [[ $STYLE -eq 1 ]]; then
  if [[ $LANG_CODE == fr ]]; then
    printf '\n\033[33m--style ignore\033[0m : les jeux de regles de vale sont anglophones.\n'
    printf '  Relance avec  \033[1mprose -e -s\033[0m  sur un texte en anglais.\n'
  elif command -v vale >/dev/null 2>&1; then
    printf '\n\033[1mStyle\033[0m \033[2m(vale)\033[0m\n'
    vale "${files[@]}" 2>&1 | sed 's/^/  /'
  fi
fi

[[ $found -eq 0 ]] && printf '\033[32m  rien a signaler\033[0m\n'
exit 0
