#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────
# herdr-new — create a space or a session, without leaving the keyboard.
#
#   herdr-new scratch            throwaway space: ~/scratch/<timestamp>
#   herdr-new space [cwd]        space on a directory (default: focused
#                                pane's cwd), focuses it if it exists
#   herdr-new session <name>     new Alacritty window on that session
#   herdr-new manage-space       picker: rename / close a space
#   herdr-new manage-session     picker: rename / delete a session
#
# Run by hand, or by the navigator's "create" entries (prefix+w).
# ─────────────────────────────────────────────────────────────────────
set -euo pipefail

PY=$(command -v python3.13 || command -v /opt/homebrew/bin/python3 || command -v python3)
ALACRITTY=/Applications/Alacritty.app/Contents/MacOS/alacritty
SCRATCH_ROOT="${HERDR_SCRATCH_ROOT:-$HOME/scratch}"

if [[ -z ${HERDR_SOCKET_PATH:-} ]]; then
  s="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/herdr.sock"
  [[ -S $s ]] && export HERDR_SOCKET_PATH="$s"
fi

jqp() { "$PY" -c "import json,sys; d=json.load(sys.stdin); print(eval('d'+sys.argv[1]))" "$1"; }

# Creates the space, then the extra tabs. Returns the space id.
make_space() { # $1 = cwd, $2 = label
  local out ws
  out=$(herdr workspace create --cwd "$1" --label "$2" --focus)
  ws=$(printf '%s' "$out" | jqp "['result']['workspace']['workspace_id']")
  printf '%s' "$ws"
}

# Adds a tab that runs a command. The tab stays in the background so the
# first one keeps focus.
add_tab() { # $1 = ws, $2 = label, $3 = cwd, $4 = command (optional)
  local out pane
  out=$(herdr tab create --workspace "$1" --label "$2" --cwd "$3" --no-focus)
  [[ -n ${4:-} ]] || return 0
  pane=$(printf '%s' "$out" | jqp "['result']['root_pane']['pane_id']")
  herdr pane run "$pane" "$4" >/dev/null
}

# Does a space already have this label? (the automatic-rename plugin
# prefixes "[N] ", ignore that)
find_space() { # $1 = label
  herdr workspace list 2>/dev/null | "$PY" -c '
import json, re, sys
want = sys.argv[1].casefold()
for w in json.load(sys.stdin)["result"]["workspaces"]:
    if re.sub(r"^\s*\[\d+\]\s*", "", w.get("label", "")).casefold() == want:
        print(w["workspace_id"]); break
' "$1"
}

cmd="${1:-}"; shift || true

case "$cmd" in
  scratch)
    stamp=$(date +%Y-%m-%d_%H%M%S)
    dir="$SCRATCH_ROOT/$stamp"
    mkdir -p "$dir"
    ws=$(make_space "$dir" "scratch $(date +%H:%M)")
    add_tab "$ws" "agent" "$dir" "opencode"
    echo "scratch → $dir"
    ;;

  manage-space)   exec herdr-manage space ;;
  manage-session) exec herdr-manage session ;;

  space)
    dir="${1:-}"
    if [[ -z $dir ]]; then
      dir=$(herdr pane current 2>/dev/null | "$PY" -c '
import json, sys
try: print(json.load(sys.stdin)["result"]["pane"]["cwd"])
except Exception: print("")
') || dir=""
    fi
    [[ -n $dir ]] || dir="$HOME"
    dir="${dir/#\~/$HOME}"
    [[ -d $dir ]] || { echo "répertoire introuvable : $dir" >&2; exit 1; }
    label=$(basename "$dir"); [[ $dir == "$HOME" ]] && label="~"
    if existing=$(find_space "$label") && [[ -n $existing ]]; then
      herdr workspace focus "$existing" >/dev/null
      echo "focus $label ($existing)"
    else
      make_space "$dir" "$label" >/dev/null
      echo "space $label → $dir"
    fi
    ;;

  session)
    name="${1:-}"
    [[ -n $name ]] || { echo "usage: herdr-new session <nom>" >&2; exit 1; }
    [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || { echo "nom invalide : $name" >&2; exit 1; }
    [[ -x $ALACRITTY ]] || { echo "Alacritty introuvable : $ALACRITTY" >&2; exit 1; }
    # A session is a separate server, it needs its own window.
    # `msg create-window` reuses the running Alacritty process
    # (ipc_socket = true) instead of starting a second one.
    "$ALACRITTY" msg create-window --title "herdr · $name" \
      -e /bin/zsh -lc "exec herdr --session $name" 2>/dev/null \
      || open -na Alacritty --args -e /bin/zsh -lc "exec herdr --session $name"
    echo "session $name"
    ;;

  *)
    sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
    exit 1 ;;
esac
