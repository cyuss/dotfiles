#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────
# herdr-nav-goto-tab <tab_id> <workspace_id>
#
# The "open" action of the navigator's `tabs` integration.
#
# Focus the SPACE first, then the tab. `herdr tab focus` alone is probably
# enough, but nothing guarantees it for a tab in an unfocused space. And
# the reverse order is wrong: focusing the space after the tab jumps back
# to the space's active tab, not the one you picked.
# ─────────────────────────────────────────────────────────────────────
set -uo pipefail

TAB="${1:-}"
WS="${2:-}"

[[ -n $TAB ]] || { echo "usage: herdr-nav-goto-tab <tab_id> [workspace_id]" >&2; exit 1; }

if [[ -z ${HERDR_SOCKET_PATH:-} ]]; then
  s="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/herdr.sock"
  [[ -S $s ]] && export HERDR_SOCKET_PATH="$s"
fi

# workspace_id is the tab_id prefix ("w4:t1" -> "w4"). Used as a fallback
# if the caller didn't pass it.
[[ -n $WS ]] || WS="${TAB%%:*}"

[[ -n $WS ]] && herdr workspace focus "$WS" >/dev/null 2>&1
exec herdr tab focus "$TAB"
