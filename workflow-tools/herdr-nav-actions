#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────
# herdr-nav-actions — every plugin action, in the navigator.
#
# WHY
# The navigator's Ctrl-N filter is called "plugin", but it does NOT show
# herdr plugins. It shows `Source::Integration`, i.e. the [[integrations]]
# blocks from its own config. So it looks like there's only space stuff.
#
# The real plugin actions live behind `herdr plugin action`. This
# collects them all (64 actions, 20 plugins here) and puts them in the
# same picker.
#
# CONTEXTS
# An action declares its contexts: global, workspace, pane. The ones that
# need a pane ("attach a monitor to THIS pane") get a marker, because
# from the picker they apply to the pane that had focus before it opened.
# ─────────────────────────────────────────────────────────────────────
set -uo pipefail

PY=$(command -v python3.13 || command -v /opt/homebrew/bin/python3 || command -v python3)

if [[ -z ${HERDR_SOCKET_PATH:-} ]]; then
  s="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/herdr.sock"
  [[ -S $s ]] && export HERDR_SOCKET_PATH="$s"
fi

RAW=$(herdr plugin action list 2>/dev/null)
[[ -n $RAW ]] || { echo "[]"; exit 0; }

# Drop the navigator's own actions: running them FROM the navigator
# would open a navigator inside the navigator.
RAW="$RAW" "$PY" - <<'PYEOF'
import json, os, sys

try:
    d = json.loads(os.environ["RAW"])
    actions = d.get("result", {}).get("actions") or d.get("actions") or []
except Exception:
    print("[]"); sys.exit(0)

SKIP = {"herdr-navigator"}

items = []
for a in sorted(actions, key=lambda x: (x.get("plugin_id", ""), x.get("title", ""))):
    plugin = a.get("plugin_id", "")
    if plugin in SKIP:
        continue
    action = a.get("action_id", "")
    if not action:
        continue

    # Most plugins already title it "Plugin: action". So no re-prefix,
    # only fill it in when it's missing.
    title = (a.get("title") or f"{plugin}: {action}").strip()

    sub = (a.get("description") or "").strip()
    ctx = a.get("contexts") or []
    if "pane" in ctx and "global" not in ctx:
        sub = (sub + "  ·  s'applique au pane courant").strip()
    if not sub:
        sub = plugin

    items.append({
        # The id carries both parts, herdr-nav-invoke splits them.
        "id": f"{plugin}\t{action}",
        "title": title,
        "subtitle": sub,
        "path": os.path.expanduser("~"),
        "kind": "",
    })

print(json.dumps(items, ensure_ascii=False))
PYEOF
