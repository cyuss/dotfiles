#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────
# herdr-nav-actions — toutes les actions de plugin, dans le navigator.
#
# POURQUOI
# Le filtre Ctrl-N du navigator s'appelle « plugin », mais il ne montre
# PAS les plugins herdr : il montre la source `Source::Integration`,
# c'est-a-dire les blocs [[integrations]] de sa propre config. D'ou
# l'impression qu'il n'y a que la gestion des spaces.
#
# Les vraies actions de plugin vivent derriere `herdr plugin action`.
# Ce script les collecte toutes (64 actions, 20 plugins ici) et les
# expose dans le meme picker.
#
# CONTEXTES
# Une action declare ses contextes : global, workspace, pane. Celles qui
# exigent un pane (« attacher un moniteur a CE pane ») sont marquees,
# parce qu'invoquees depuis le picker elles s'appliquent au pane qui
# etait focalise avant l'ouverture.
# ─────────────────────────────────────────────────────────────────────
set -uo pipefail

PY=$(command -v python3.13 || command -v /opt/homebrew/bin/python3 || command -v python3)

if [[ -z ${HERDR_SOCKET_PATH:-} ]]; then
  s="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/herdr.sock"
  [[ -S $s ]] && export HERDR_SOCKET_PATH="$s"
fi

RAW=$(herdr plugin action list 2>/dev/null)
[[ -n $RAW ]] || { echo "[]"; exit 0; }

# Les actions du navigator lui-meme sont retirees : les invoquer DEPUIS
# le navigator ouvrirait un navigator dans le navigator.
RAW="$RAW" "$PY" - <<'PYEOF'
import json, os, sys

try:
    d = json.loads(os.environ["RAW"])
    actions = d.get("result", {}).get("actions") or d.get("actions") or []
except Exception:
    print("[]"); sys.exit(0)

SKIP = {"herdr-navigator"}

items = []
for a in sorted(actions, key=lambda x: (x.get("plugin_id", ""), x.get("title", ""))):
    plugin = a.get("plugin_id", "")
    if plugin in SKIP:
        continue
    action = a.get("action_id", "")
    if not action:
        continue

    # Le titre porte deja « Plugin: action » chez la plupart des plugins.
    # On ne re-prefixe donc pas, on complete seulement quand il manque.
    title = (a.get("title") or f"{plugin}: {action}").strip()

    sub = (a.get("description") or "").strip()
    ctx = a.get("contexts") or []
    if "pane" in ctx and "global" not in ctx:
        sub = (sub + "  ·  s'applique au pane courant").strip()
    if not sub:
        sub = plugin

    items.append({
        # L'id porte les deux morceaux ; herdr-nav-invoke les separe.
        "id": f"{plugin}\t{action}",
        "title": title,
        "subtitle": sub,
        "path": os.path.expanduser("~"),
        "kind": "",
    })

print(json.dumps(items, ensure_ascii=False))
PYEOF
