#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────
# herdr-navigator-fresh — the navigator (prefix+w), but never stale.
#
# The navigator lists projects from herdr-plus TOML templates. Those are
# generated by herdr-sync-projects, so a repo cloned after the last sync
# stays invisible, silently. Hence this: resync BEFORE opening the picker.
#
# `--if-needed` makes the usual case free: it only compares the repo list
# with the generated templates, and exits if they match. No `git log` on
# every prefix+w.
#
# Run from a `type = "shell"` binding: detached, so no login PATH and no
# pane context. Set the socket ourselves, like herdr-open-project.
# ─────────────────────────────────────────────────────────────────────
set -uo pipefail

if [[ -z ${HERDR_SOCKET_PATH:-} ]]; then
  default_sock="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/herdr.sock"
  [[ -S $default_sock ]] || { echo "serveur herdr injoignable" >&2; exit 1; }
  export HERDR_SOCKET_PATH="$default_sock"
fi

# Silent, best-effort resync: if it fails (missing macOS Desktop
# permission, no herdr-plus…), the navigator still opens on the existing
# index. A stale index beats no navigator.
"$HOME/.config/workflow-tools/herdr-sync-projects" --if-needed >/dev/null 2>&1 || true

# The plugin gets reinstalled under a path that changes, so resolve it
# through the API instead of hardcoding it.
PY=$(command -v python3.13 || command -v /opt/homebrew/bin/python3 || command -v python3)
ROOT=$(herdr plugin list --json 2>/dev/null | "$PY" -c '
import json, sys
try:
    for p in json.load(sys.stdin)["result"]["plugins"]:
        if p.get("plugin_id") == "herdr-navigator":
            print(p["plugin_root"]); break
except Exception:
    pass
')

NAV="$ROOT/target/release/herdr-navigator"
if [[ -n ${ROOT:-} && -x $NAV ]]; then
  exec "$NAV" open
fi

# Fallback: the plugin action, same route the binary would have taken.
exec herdr plugin pane open --plugin herdr-navigator --entrypoint picker --focus
