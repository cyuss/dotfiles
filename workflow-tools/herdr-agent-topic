#!/usr/bin/env python3
# ─────────────────────────────────────────────────────────────────────
# herdr-agent-topic — hook UserPromptSubmit de Claude Code.
#
# Probleme resolu : Claude Code ecrit le titre du terminal une fois, en
# debut de session, et ne le rafraichit plus. Au bout de quelques heures la
# sidebar herdr annonce encore le sujet du matin — « Corne keyboard
# directional keys… » alors que la conversation porte sur tout autre chose.
#
# Ce hook se declenche a CHAQUE message envoye et fait deux choses :
#
#   1. renvoie {"sessionTitle": ...} — Claude Code reecrit alors son propre
#      titre de session, donc terminal_title, donc la sidebar, le titre de
#      fenetre macOS et le jeton $title d'usagebar, d'un seul coup ;
#   2. publie le meme texte comme jeton de pane $topic, en filet : il ne
#      depend d'aucun comportement interne de Claude Code.
#
# CONTRAINTES DE SECURITE d'un hook UserPromptSubmit — les deux comptent :
#   - sa sortie standard est INJECTEE DANS LE CONTEXTE si ce n'est pas du
#     JSON reconnu. On n'ecrit donc rien d'autre que l'objet attendu.
#   - le code de sortie 2 BLOQUE le message de l'utilisateur. On sort donc
#     toujours 0, quoi qu'il arrive.
#
# Ne touche pas a ~/.claude/hooks/herdr-agent-state.sh, qui porte la mention
# « managed by herdr » et serait ecrase a la prochaine mise a jour.
# ─────────────────────────────────────────────────────────────────────
import json
import os
import re
import subprocess
import sys

MAX = 48          # le titre sert aussi a la fenetre macOS, plus large que 28
TTL_MS = 86_400_000

# Tournures d'ouverture sans valeur informative. L'ordre compte : les plus
# longues d'abord, sinon « je veux » mangerait le debut de « je veux que tu ».
OPENERS = [
    "est-ce que tu peux", "est ce que tu peux", "est-ce qu'il", "est ce qu il",
    "j'aimerais que tu", "je voudrais que tu", "je veux que tu",
    "peux-tu", "peux tu", "tu peux", "pourrais-tu", "pourrais tu",
    "j'aimerais", "je voudrais", "je veux", "il faudrait", "il faut",
    "fais-moi", "fais moi", "donne-moi", "donnes moi", "donne moi",
    "trouve-moi", "trouves moi", "trouve moi", "montre-moi", "montres moi",
    "corriges", "corrige", "ameliores", "ameliore", "appliques", "applique",
    "maintenant", "aussi", "ok", "et", "stp", "svp",
]
TRAILERS = ["stp", "svp", "s'il te plait", "s il te plait", "merci"]


def condense(text):
    """Premiere ligne utile du message, debarrassee du remplissage."""
    line = next((l.strip() for l in text.splitlines() if l.strip()), "")
    # Une commande slash ou un bloc colle : on garde tel quel, tronque.
    line = re.sub(r"\s+", " ", line)

    low = line.lower()
    changed = True
    while changed:                      # « ok, et maintenant peux tu … »
        changed = False
        for op in OPENERS:
            if low.startswith(op + " ") or low == op:
                line = line[len(op):].lstrip(" ,:;")
                low = line.lower()
                changed = True
                break

    for tr in TRAILERS:
        if low.endswith(" " + tr):
            line = line[: -(len(tr) + 1)].rstrip(" ,.!?")
            low = line.lower()

    line = line.strip(" ,.!?:;-")
    if not line:
        return ""
    if len(line) > MAX:                 # coupe sur un mot, jamais au milieu
        cut = line[:MAX].rsplit(" ", 1)[0]
        line = (cut if len(cut) >= MAX // 2 else line[:MAX]).rstrip(" ,.!?:;-") + "…"
    return line[0].upper() + line[1:]


def publish(topic):
    """Filet : le meme texte comme jeton de pane, independant de Claude Code."""
    pane = os.environ.get("HERDR_PANE_ID")
    if not pane or not os.environ.get("HERDR_SOCKET_PATH"):
        return
    try:
        subprocess.run(
            ["herdr", "pane", "report-metadata", pane,
             "--source", "herdr-agent-topic",
             "--token", f"topic={topic}", "--ttl-ms", str(TTL_MS)],
            timeout=3, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass                            # un filet qui casse ne casse rien


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return
    if payload.get("hook_event_name") != "UserPromptSubmit":
        return
    topic = condense(payload.get("prompt") or "")
    if not topic:
        return
    publish(topic)
    json.dump({"hookEventName": "UserPromptSubmit", "sessionTitle": topic},
              sys.stdout, ensure_ascii=False)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass                            # sortie 2 = message bloque. Jamais.
    sys.exit(0)
