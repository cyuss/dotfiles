#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────
# herdr-open-project <name> — opens a herdr-plus template, OR focuses it
# if it's already open.
#
# Why: `herdr-plus open <name>` always calls workspaceCreate (checked in
# projects.go). Fine for a one-off project, but for a base space I go back
# to ten times a day it piles up duplicates. So look for an existing space
# first.
#
# The automatic-rename plugin prefixes labels with "[N] ", the match
# ignores that prefix.
#
#   herdr-open-project quotidien
#   herdr-open-project --new quotidien   force a new space
# ─────────────────────────────────────────────────────────────────────
set -euo pipefail

FORCE_NEW=0
[[ "${1:-}" == "--new" ]] && { FORCE_NEW=1; shift; }
NAME="${1:-}"
[[ -n $NAME ]] || { echo "usage: herdr-open-project [--new] <nom-du-template>" >&2; exit 1; }

# Don't require HERDR_ENV: a `type = "shell"` binding doesn't always pass
# the pane context. What's really needed is the socket. herdr-plus reads
# it from HERDR_SOCKET_PATH, so set it if it's missing.
if [[ -z ${HERDR_SOCKET_PATH:-} ]]; then
  default_sock="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/herdr.sock"
  [[ -S $default_sock ]] || { echo "serveur herdr injoignable" >&2; exit 1; }
  export HERDR_SOCKET_PATH="$default_sock"
fi
[[ -S $HERDR_SOCKET_PATH ]] || { echo "socket herdr absente : $HERDR_SOCKET_PATH" >&2; exit 1; }

PY=$(command -v python3.13 || command -v /opt/homebrew/bin/python3 || command -v python3)

# Does an existing space have this name? (label stripped of "[N] ")
if [[ $FORCE_NEW -eq 0 ]]; then
  ws=$(herdr workspace list 2>/dev/null | "$PY" -c '
import json, re, sys
want = sys.argv[1].casefold()
try:
    data = json.load(sys.stdin)["result"]["workspaces"]
except Exception:
    sys.exit(0)
for w in data:
    label = re.sub(r"^\s*\[\d+\]\s*", "", w.get("label", ""))
    if label.casefold() == want:
        print(w["workspace_id"]); break
' "$NAME")
  if [[ -n ${ws:-} ]]; then
    herdr workspace focus "$ws" >/dev/null
    echo "focus $NAME ($ws)"
    exit 0
  fi
fi

# Otherwise build it with herdr-plus. Its path changes on every reinstall,
# so resolve it through the API instead of hardcoding it.
ROOT=$(herdr plugin list --json 2>/dev/null | "$PY" -c '
import json, sys
try:
    for p in json.load(sys.stdin)["result"]["plugins"]:
        if p.get("plugin_id") == "cloudmanic.herdr-plus":
            print(p["plugin_root"]); break
except Exception:
    pass
')
[[ -n ${ROOT:-} && -x "$ROOT/bin/herdr-plus" ]] || {
  echo "herdr-plus introuvable — herdr plugin install cloudmanic/herdr-plus" >&2; exit 1; }

exec "$ROOT/bin/herdr-plus" open "$NAME"
