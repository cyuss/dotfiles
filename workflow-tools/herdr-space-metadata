#!/usr/bin/env python3
# ─────────────────────────────────────────────────────────────────────
# herdr-space-metadata — feeds the $sync token on space rows.
#
# Why: herdr sidebar space rows only take five built-in tokens
# (state_icon, state_text, workspace, branch, git_status). Anything else
# goes through WORKSPACE METADATA, which herdr doesn't produce itself.
# You have to push it:
#
#   herdr workspace report-metadata <id> --source X --token NAME=VALUE
#
# Same mechanism usagebar uses on the pane side for $context and $limit.
# This is the space side.
#
# What it shows: `git_status` (built-in) already shows the working tree
# state. What was visible NOWHERE is the gap with upstream, i.e. commits
# I forgot to push.
#
#   ↑2   2 commits ahead of upstream
#   ↓1   1 commit behind
#   ⚑3   3 pending stashes
#
# The workspace has no cwd (checked: `herdr workspace get` returns
# label/tabs/panes, no path). So it's derived from the panes, which do
# carry their cwd.
#
#   herdr-space-metadata              one pass, then exit
#   herdr-space-metadata --watch      loop (default: 45 s)
#   herdr-space-metadata --watch 20   loop, custom interval
#   herdr-space-metadata --clear      clear the token everywhere
#   herdr-space-metadata -v           show what gets pushed
#
# TTL is 4x the interval: if this script dies, the tokens clear on their
# own instead of showing a wrong value forever.
# ─────────────────────────────────────────────────────────────────────
import json
import os
import subprocess
import sys
import time

SOURCE = "herdr-space-metadata"
TOKEN = "sync"
DEFAULT_INTERVAL = 45


def run(cmd, cwd=None, timeout=5):
    """Returns stripped stdout, or None if the command fails."""
    try:
        r = subprocess.run(
            cmd, cwd=cwd, timeout=timeout,
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    return r.stdout.decode("utf-8", "replace").strip()


def workspace_dirs():
    """workspace_id -> cwd, derived from panes (the workspace has no cwd)."""
    out = run(["herdr", "pane", "list"])
    if not out:
        return {}
    try:
        panes = json.loads(out)["result"]["panes"]
    except (ValueError, KeyError, TypeError):
        return {}
    dirs = {}
    for pane in panes:
        ws, cwd = pane.get("workspace_id"), pane.get("cwd")
        # First pane seen is the oldest in the space, so the most
        # representative. Later ones from the same space are skipped.
        if ws and cwd and ws not in dirs:
            dirs[ws] = cwd
    return dirs


def sync_state(cwd):
    """'↑2 ↓1 ⚑3', or '' if nothing to report / not a git repo."""
    if not os.path.isdir(cwd):
        return ""
    if run(["git", "rev-parse", "--is-inside-work-tree"], cwd=cwd) != "true":
        return ""

    parts = []

    # @{upstream}...HEAD: left = upstream commits missing locally (behind),
    # right = local commits missing upstream (ahead).
    # Fails silently if the branch has no upstream, which is normal.
    counts = run(
        ["git", "rev-list", "--left-right", "--count", "@{upstream}...HEAD"],
        cwd=cwd,
    )
    if counts:
        try:
            behind, ahead = (int(x) for x in counts.split())
        except ValueError:
            behind = ahead = 0
        if ahead:
            parts.append(f"↑{ahead}")
        if behind:
            parts.append(f"↓{behind}")

    stash = run(["git", "stash", "list"], cwd=cwd)
    if stash:
        parts.append(f"⚑{len(stash.splitlines())}")

    return " ".join(parts)


def publish(ws, value, ttl_ms, verbose=False):
    base = ["herdr", "workspace", "report-metadata", ws, "--source", SOURCE]
    if value:
        cmd = base + ["--token", f"{TOKEN}={value}", "--ttl-ms", str(ttl_ms)]
    else:
        # An empty token would still be shown as is, so clear it outright.
        cmd = base + ["--clear-token", TOKEN]
    ok = run(cmd) is not None
    if verbose:
        state = value or "(vide)"
        print(f"{ws:<6} {state:<16} {'ok' if ok else 'ECHEC'}", file=sys.stderr)
    return ok


def pass_once(ttl_ms, verbose=False, clear=False):
    dirs = workspace_dirs()
    if not dirs and verbose:
        print("aucun space (serveur herdr arrete ?)", file=sys.stderr)
    for ws, cwd in sorted(dirs.items()):
        publish(ws, "" if clear else sync_state(cwd), ttl_ms, verbose)
    return len(dirs)


def main():
    args = sys.argv[1:]
    verbose = False
    clear = False
    watch = False
    interval = DEFAULT_INTERVAL

    i = 0
    while i < len(args):
        a = args[i]
        if a in ("-v", "--verbose"):
            verbose = True
        elif a == "--clear":
            clear = True
        elif a == "--watch":
            watch = True
            # Optional interval right after --watch.
            if i + 1 < len(args) and args[i + 1].isdigit():
                i += 1
                interval = max(5, int(args[i]))
        elif a in ("-h", "--help"):
            print(__doc__ or "", end="")
            sys.exit(0)
        else:
            print(f"argument inconnu : {a}", file=sys.stderr)
            sys.exit(2)
        i += 1

    ttl_ms = min(86_400_000, max(1, interval * 4 * 1000))

    if not watch:
        pass_once(ttl_ms, verbose, clear)
        return

    while True:
        try:
            pass_once(ttl_ms, verbose, clear)
        except Exception as exc:  # a failed pass must not kill the loop
            print(f"passe ignoree : {exc}", file=sys.stderr)
        time.sleep(interval)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
