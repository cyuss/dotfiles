#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────
# finder-merge — fold every Finder window into ONE window with tabs.
#
# Why: AeroSpace tiles windows, so each Finder window takes a slot and
# Finder ends up eating half the layout. Tabs live inside one window:
# ten tabs = one window = one slot. Window > "Merge All Windows" does
# exactly that.
#
# Tried and doesn't work on this macOS:
#   defaults write -g AppleWindowTabbingMode -string always
#   defaults write com.apple.finder FinderSpawnTab -bool true
# Neither changes what Cmd+N does in Finder (checked by counting windows
# before/after, Finder restarted between tries). Cmd+N is "New Window"
# and Cmd+T is "New Tab", two separate commands, not a setting.
#
# Usage
#   finder-merge          merge now
# AeroSpace also calls it on every new Finder window (on-window-detected).
# ─────────────────────────────────────────────────────────────────────
set -uo pipefail

# Nothing to do with fewer than two windows. The menu click would
# activate Finder for nothing and steal focus.
n=$(osascript -e 'tell application "Finder" to return (count of every window)' 2>/dev/null || echo 0)
[[ ${n:-0} -ge 2 ]] || exit 0

osascript <<'APPLESCRIPT' >/dev/null 2>&1
tell application "System Events"
  tell process "Finder"
    -- With a single window macOS greys out or removes the item,
    -- hence the try.
    try
      click menu item "Merge All Windows" of menu 1 of menu bar item "Window" of menu bar 1
    end try
  end tell
end tell
APPLESCRIPT
