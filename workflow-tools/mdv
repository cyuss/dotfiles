#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────
# mdv — read rendered Markdown in the terminal.
#
#   mdv file.md           render the file
#   mdv                   browse the .md files in the current dir (TUI)
#   mdv ~/.config/docs    browse a folder
#   cat x.md | mdv        from a pipe
#   mdv -w 120 f.md       force a width
#   mdv -b file.md        BROWSE: side outline, clickable links,
#                         history, bookmarks  (frogmouth)
#   mdv -l file.md        LIVE preview: re-renders on every save
#                         (watchexec), the screen next to the editor
#
# Called `mdv' and not `md': `md' is already an alias for `mkdir -p' in
# ~/.config/zsh/aliases.zsh, and that habit stays.
#
# Why a wrapper and not plain `glow': glow 3.0.0 ignores both
# ~/.config/glow/glow.yml and GLAMOUR_STYLE (checked, width and style
# there do nothing). Only the `-s' flag works. So the theme lives here,
# and the width follows the window while we're at it.
#
# No images, and that's not glow's fault. Alacritty (0.16.1) has no
# graphics protocol (no sixel, no kitty protocol), and every terminal
# image viewer (mdcat, timg, chafa in pixel mode) needs one of them.
# Nothing to configure while on Alacritty. kitty or WezTerm could do it.
# ─────────────────────────────────────────────────────────────────────
set -uo pipefail

STYLE="${MD_STYLE:-$HOME/.config/glow/premium-noir.json}"
[[ -r $STYLE ]] || STYLE=dark

# Width: window minus glow's margins, capped at 100. Wider than that the
# eye loses the line, and on an ultrawide glow would take everything.
cols=$(tput cols 2>/dev/null || echo 100)
WIDTH=$(( cols - 6 )); [[ $WIDTH -gt 100 ]] && WIDTH=100
[[ $WIDTH -lt 40 ]] && WIDTH=40

args=(); MODE=render
while [[ $# -gt 0 ]]; do
  case "$1" in
    -w|--width)  WIDTH="$2"; shift 2 ;;
    -b|--browse) MODE=browse; shift ;;
    -l|--live)   MODE=live;   shift ;;
    -h|--help)   sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)           args+=("$1"); shift ;;
  esac
done

# ── Browse mode: frogmouth ──────────────────────────────────────────
# What glow can't do: side outline, links you can follow, back/forward
# history and bookmarks. For a docs folder you browse, not read in one go.
#   t  outline    /  search      ,/.  history      b  bookmarks  q  quit
if [[ $MODE == browse ]]; then
  command -v frogmouth >/dev/null 2>&1 || {
    echo "mdv: frogmouth absent — uv tool install frogmouth" >&2; exit 1; }
  exec frogmouth "${args[@]}"
fi

# ── Live preview: re-render on every save ───────────────────────────
# Watch the FILE, not the folder, or every Emacs temp file (#foo.md#,
# .#foo.md) would trigger a re-render.
if [[ $MODE == live ]]; then
  command -v watchexec >/dev/null 2>&1 || {
    echo "mdv: watchexec absent — brew install watchexec" >&2; exit 1; }
  [[ ${#args[@]} -eq 0 ]] && { echo "mdv -l : indique un fichier" >&2; exit 1; }
  exec watchexec --clear --no-vcs-ignore --watch "${args[0]}" -- \
       glow -s "$STYLE" -w "$WIDTH" "${args[0]}"
fi

# From a pipe: glow reads stdin with `-`.
if [[ ! -t 0 && ${#args[@]} -eq 0 ]]; then
  exec glow -s "$STYLE" -w "$WIDTH" -
fi

# No argument, or a folder: TUI mode, which lists the .md files and lets
# you move around. That's what makes ~/.config/docs readable.
if [[ ${#args[@]} -eq 0 ]]; then
  exec glow -s "$STYLE" -w "$WIDTH" -t .
fi
if [[ -d "${args[0]}" ]]; then
  exec glow -s "$STYLE" -w "$WIDTH" -t "${args[0]}"
fi

# A file: page it only if it doesn't fit on screen.
lines=$(glow -s "$STYLE" -w "$WIDTH" "${args[@]}" 2>/dev/null | wc -l)
if [[ ${lines:-0} -gt $(( $(tput lines 2>/dev/null || echo 40) - 2 )) ]]; then
  exec glow -s "$STYLE" -w "$WIDTH" -p "${args[@]}"
fi
exec glow -s "$STYLE" -w "$WIDTH" "${args[@]}"
