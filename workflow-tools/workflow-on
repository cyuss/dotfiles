#!/usr/bin/env bash
set -euo pipefail

TOOLS_DIR="${HOME}/.config/workflow-tools"
AEROSPACE_CTL="${TOOLS_DIR}/aerospacectl"
SKETCHYBAR_CTL="${TOOLS_DIR}/sketchybarctl"
MARGIN_CTL="${TOOLS_DIR}/bar-margin-profile"

# Ensure conflicting daemons are off
pkill -x skhd 2>/dev/null || true
pkill -x yabai 2>/dev/null || true

# Start workflow services
"${AEROSPACE_CTL}" start
"${SKETCHYBAR_CTL}" start

# Apply margins based on monitor setup and reload
"${MARGIN_CTL}" apply auto >/dev/null 2>&1 || true
"${AEROSPACE_CTL}" reload >/dev/null 2>&1 || true
"${SKETCHYBAR_CTL}" reload >/dev/null 2>&1 || true

echo "Workflow enabled. AeroSpace + SketchyBar are active."
