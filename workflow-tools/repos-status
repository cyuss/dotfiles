#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────
# repos-status — the state of every repo at once.
#
# One line per repo that needs something: modified tracked files,
# unpushed commits, commits behind. Clean repos are counted, not listed.
# Repos are checked IN PARALLEL (~8 at a time), otherwise 28 repos x 3
# git calls take around fifteen seconds.
#
#   repos-status              ~/Desktop/projects
#   repos-status ~/other      another folder
#   repos-status --all        also show clean repos
#   repos-status --untracked  also count untracked files (SLOW)
#
# Defaults to `git status -uno`, so untracked files are NOT scanned.
# That scan is the expensive part (a repo with an unignored .venv or
# .tox can take 18 s vs 15 ms with -uno), and it's not the useful signal
# here anyway. What needs action is modified tracked files and drift
# from upstream.
#
# Variables: REPOS_STATUS_TIMEOUT (default 5 s per git call)
#            REPOS_STATUS_JOBS    (default 8)
# ─────────────────────────────────────────────────────────────────────
set -uo pipefail

ROOT="${HOME}/Desktop/projects"
ALL=0
UNTRACKED=0
TMO="${REPOS_STATUS_TIMEOUT:-5}"
JOBS="${REPOS_STATUS_JOBS:-8}"

# ── Internal mode: check ONE repo and print a "state<TAB>text" line.
if [[ "${1:-}" == "--one" ]]; then
  d="$2"; UNTRACKED="$3"; TMO="$4"
  # Folders that aren't repos exit quietly. Otherwise they all showed up
  # as "too slow", which was wrong and noisy.
  [[ -e "$d/.git" ]] || exit 0
  TO=$(command -v timeout || command -v gtimeout || true)
  g() { if [[ -n $TO ]]; then "$TO" "$TMO" git -C "$d" "$@"; else git -C "$d" "$@"; fi; }
  name=$(basename "$d")

  branch=$(g symbolic-ref --quiet --short HEAD 2>/dev/null) || branch=""
  [[ -n $branch ]] || branch="detached"

  ustyle=(-uno); [[ $UNTRACKED -eq 1 ]] && ustyle=(-unormal)
  if ! porcelain=$(g status --porcelain "${ustyle[@]}" 2>/dev/null); then
    printf 'slow\t%s\n' "$name"; exit 0
  fi
  dirty=$(printf '%s' "$porcelain" | grep -c . || true)

  ahead=0 behind=0
  if up=$(g rev-parse --abbrev-ref '@{upstream}' 2>/dev/null); then
    counts=$(g rev-list --left-right --count "$up...HEAD" 2>/dev/null || printf '0\t0')
    behind=$(printf '%s' "$counts" | awk '{print $1+0}')
    ahead=$(printf  '%s' "$counts" | awk '{print $2+0}')
  fi

  [[ $dirty -eq 0 && $ahead -eq 0 && $behind -eq 0 ]] \
    && printf 'clean\t%s\t%s\t0\t0\t0\n' "$name" "$branch" \
    || printf 'dirty\t%s\t%s\t%s\t%s\t%s\n' "$name" "$branch" "$dirty" "$ahead" "$behind"
  exit 0
fi

for a in "$@"; do
  case "$a" in
    --all)       ALL=1 ;;
    --untracked) UNTRACKED=1 ;;
    -h|--help)   sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)           ROOT="${a/#\~/$HOME}" ;;
  esac
done
[[ -d $ROOT ]] || { echo "introuvable : $ROOT" >&2; exit 1; }

b()  { printf '\033[1m%s\033[0m' "$1"; }
dim(){ printf '\033[2m%s\033[0m' "$1"; }

printf '%s\n' "$(b "dépôts sous ${ROOT/#$HOME/~}")"
printf '%s\n' "$(dim '──────────────────────────────────────────────────────────')"

rows=$(
  find "$ROOT" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null \
  | xargs -0 -P "$JOBS" -I{} "$0" --one {} "$UNTRACKED" "$TMO" 2>/dev/null
)

clean=$(printf '%s\n' "$rows" | grep -c '^clean' || true)
slow=$(printf  '%s\n' "$rows" | grep -c '^slow'  || true)

printf '%s\n' "$rows" | sort -t$'\t' -k2,2 | while IFS=$'\t' read -r state name branch dirty ahead behind; do
  case "$state" in
    slow) printf '  %-30s %s\n' "$name" "$(dim "trop lent (>${TMO}s), ignoré")" ;;
    clean) [[ $ALL -eq 1 ]] && printf '  %-30s %s %s\n' "$name" "$(dim "${branch:0:16}")" "$(dim 'à jour')" ;;
    dirty)
      f=""
      [[ ${dirty:-0}  -gt 0 ]] && f+=$'\033[33m±'"${dirty}"$'\033[0m '
      [[ ${ahead:-0}  -gt 0 ]] && f+=$'\033[32m↑'"${ahead}"$'\033[0m '
      [[ ${behind:-0} -gt 0 ]] && f+=$'\033[31m↓'"${behind}"$'\033[0m '
      printf '  %-30s %s %s\n' "$name" "$(dim "${branch:0:16}")" "$f" ;;
  esac
done

printf '%s\n' "$(dim '──────────────────────────────────────────────────────────')"
msg="$(printf '%s\n' "$rows" | grep -c '^dirty' || true) à traiter · ${clean} propres"
[[ ${slow:-0} -gt 0 ]] && msg+=" · ${slow} ignorés"
printf '  %s\n' "$(dim "$msg")"
