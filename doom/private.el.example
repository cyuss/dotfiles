;;; private.el.example -*- lexical-binding: t; -*-
;;
;; Copy this file to `private.el' (same folder) and fill it in.
;; `private.el' is gitignored: that's where personal values go,
;; the stuff that has no business in a public repo.
;;
;;     cp doom/private.el.example doom/private.el

(setq user-full-name    "Prenom Nom"
      user-mail-address "moi@example.com")

