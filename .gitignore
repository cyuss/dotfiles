# ══════════════════════════════════════════════════════════════
#  ~/.config: track the CONFIG, not caches, binaries,
#  runtime state or secrets.
# ══════════════════════════════════════════════════════════════

# ── Ignore everything by default, then allow things back explicitly ──
# Only safe model for a dir that third-party tools write to all the
# time: a new tool never gets committed by accident (it could hold
# a token).
*
!.gitignore
!README.md
!CHANGELOG.md
!install.sh

# ── Tracked configs ──
!alacritty/
!alacritty/**
!aerospace/
!aerospace/**
!opencode/
!opencode/**
!doom/
!doom/**
!nvim/
!nvim/**
!herdr/
!herdr/**
!tmux/
!tmux/**
!workflow-tools/
!workflow-tools/**
!lazygit/
!lazygit/**
!btop/
!btop/**
!git/
!git/**
!broot/
!broot/**
!zsh/
!zsh/**
!docs/
!docs/**
!navi/
!navi/**
!yazi/
!yazi/**
!bat/
!bat/**
!zmk/
!zmk/**
!install/
!install/**

# ── Exclusions inside tracked dirs ──
# Secrets & runtime state
**/auth.json
**/*.key
**/*.pem
**/*token*
**/*secret*
**/.env
**/.env.*

# Sockets, logs, databases, caches
**/*.sock
**/*.log
**/*.db
**/*.db-*
**/node_modules/
**/.local/
**/cache/
**/.cache/
**/plugins/github/
**/plugins.json
**/.plugins.lock
**/session.json

# ── Personal data ────────────────────────────────────────────────
# Identity (name, email): the repo is public. A template is tracked next to it.
doom/private.el

# herdr project files: GENERATED by `herdr-sync-projects'. They list the
# name, absolute path and last commit message of every local repo, so
# the full list of private projects. They rebuild themselves, nothing
# to track.
herdr/plugins/config/cloudmanic.herdr-plus/projects/

# herdr plugin runtime state. `jump-back-workspace' changes on EVERY
# jump, tracking it would leave the repo dirty all the time.
herdr/plugins/config/usagebar/update-check-state.json
herdr/plugins/config/**/state.json
herdr/plugins/config/herdr-navigator/jump-back-workspace
herdr/plugins/config/herdr-navigator/pinned-entries.json
herdr/plugins/config/herdr-lazy/bootstrapped
herdr/release-notes.json

# Doom: everything generated
doom/backup/
doom/.local/
nvim/lazy-lock.json.bak

# Python artifacts: compiled bytecode, rebuilt on every run and full of
# absolute paths. The !docs/** and !workflow-tools/** rules above pulled
# it back in. In .gitignore the LAST matching rule wins, so these two
# lines must stay AFTER the allowlists.
__pycache__/
*.pyc

# docs: PDFs are build ARTIFACTS (4.6 MB), rebuilt by docs/src/build
docs/*.pdf

# docs: the HTML is an ARTIFACT too. `<name>_doc.py' rewrites
# `<name>-cover.html' and `<name>-body.html' on every `./build'. They're
# minified on one line, so tracking them meant a full-page diff for a
# date change.
docs/src/*-body.html
docs/src/*-cover.html

# zsh: cache antidote builds from .zsh_plugins.txt
zsh/.zsh_plugins.zsh
zsh/.zcompdump*

# macOS
.DS_Store
