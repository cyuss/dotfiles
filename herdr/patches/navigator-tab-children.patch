+/// Is the picker pane still running the navigator?
+///
+/// That was the missing check. When the `ui` process dies without its
+/// pane closing, herdr leaves a SHELL in the pane, but the pane keeps
+/// its "Herdr Navigator" label. `picker_pane_decision` kept finding it
+/// and focused that dead shell: prefix+w seemed to do nothing, and you
+/// needed the mouse to get out.
+///
+/// So we ask for the foreground process. A pane whose foreground isn't
+/// the navigator is stale.
+fn picker_pane_is_live(pane_id: &str) -> bool {
+    let Ok(info) = herdr::herdr_json(["pane", "process-info", "--pane", pane_id]) else {
+        // No answer: can't say anything. Keep the original behavior
+        // (focus) instead of closing a pane that might be alive.
+        //
+        return true;
+    };
+    let Some(procs) = info
+        .pointer("/result/process_info/foreground_processes")
+        .and_then(|v| v.as_array())
+    else {
+        return true;
+    };
+    procs.iter().any(|p| {
+        let name = p.get("name").and_then(|v| v.as_str()).unwrap_or("");
+        let cmd = p.get("cmdline").and_then(|v| v.as_str()).unwrap_or("");
+        name.contains("herdr-navigator") || cmd.contains("herdr-navigator")
+    })
+}
+
 fn open_picker() -> ! {
     let json = herdr::herdr_json(["pane", "list"]).unwrap_or(serde_json::Value::Null);
     match picker_pane_decision(&json) {
         PickerDecision::Open => open_plugin_pane("picker", &["--focus"]),
-        PickerDecision::Focus(id) => run_plugin_pane_cmd("focus", &id),
+        PickerDecision::Focus(id) => {
+            if picker_pane_is_live(&id) {
+                run_plugin_pane_cmd("focus", &id)
+            } else {
+                // Stale pane: close it and start clean, instead of leaving
+                // prefix+w dead until someone fixes it by hand.
+                //
+                //
+                // `pane close`, not `plugin pane close`: as soon as the
+                // plugin process dies, herdr loses the plugin<->pane link
+                // and `plugin pane close` answers `plugin_pane_not_found`.
+                // Which is exactly the case we're trying to catch here.
+                //
+                let _ = Command::new(herdr_bin())
+                    .args(["pane", "close", &id])
+                    .status();
+                open_plugin_pane("picker", &["--focus"])
+            }
+        }
     }
 }
 
