+/// Une ligne ENFANT : un tab, sous son space, dans la source `open`.
+///
+/// Elle porte `Source::Workspace` pour apparaitre dans la meme section que
+/// les spaces (c'est ce que la vue arborescente demande) et `tab_id` pour
+/// que le rendu et Ctrl-X sachent qu'il s'agit d'un tab et pas d'un space.
+///
+/// L'action passe par `RunCommand` plutot que par une variante dediee :
+/// on focalise le space PUIS le tab. L'ordre compte — focaliser le space
+/// apres le tab ramenerait sur le tab actif du space, pas sur celui choisi.
+fn tab_entry(
+    t: &Value,
+    position: usize,
+    ws_id: &str,
+    ws_label: &str,
+    path: &Path,
+    last: bool,
+) -> Entry {
+    let tab_id = t.get("tab_id").and_then(|v| v.as_str()).unwrap_or("");
+    // POSITION d'affichage, et surtout PAS le champ `number`.
+    //
+    // `number` est un compteur de creation : il suit le tab_id (« wC:t4 »
+    // -> 4) et garde les trous laisses par les tabs fermes. herdr, lui,
+    // numerote la barre d'onglets par POSITION — un space dont on a ferme
+    // un tab affiche donc « [2] » sur un tab dont `number` vaut 4.
+    //
+    // Afficher « tab 4 » etait donc trompeur a deux titres : ca ne
+    // correspond pas a ce que montre la barre d'onglets, et `switch_tab =
+    // "prefix+1..9"` est une liaison INDEXEE, qui vise la position. Lire
+    // « tab 4 » et taper prefix+4 ne menait nulle part.
+    let panes = t.get("pane_count").and_then(|v| v.as_i64()).unwrap_or(1);
+    let status = t
+        .get("agent_status")
+        .and_then(|v| v.as_str())
+        .unwrap_or("unknown");
+    let focused = t.get("focused").and_then(|v| v.as_bool()).unwrap_or(false);
+    // herdr prefixe ses libelles du numero d'affichage (« [2] zsh ») ; le
+    // numero est deja dans `number`, on evite « ├ [2] zsh · tab 2 ».
+    let raw = t.get("label").and_then(|v| v.as_str()).unwrap_or("tab");
+    let name = strip_index_prefix(raw);
+    let branch = if last { "└" } else { "├" };
+
+    let mut meta = format!("tab {position}");
+    if panes > 1 {
+        meta.push_str(&format!(" · {panes} panes"));
+    }
+    if focused {
+        meta.push_str(" · courant");
+    }
+
+    Entry {
+        source: Source::Workspace,
+        tab_id: Some(tab_id.into()),
+        title: format!("  {branch} {name}"),
+        // Meme forme que pour un space : `entry_status` lit le prefixe
+        // `agent:` et `entry_metadata` ce qui suit le premier ` · `.
+        subtitle: format!("agent:{status} · {meta}"),
+        path: path.to_path_buf(),
+        workspace_id: Some(ws_id.into()),
+        workspace_label: Some(ws_label.into()),
+        agent_target: None,
+        project: None,
+        action: EntryAction::RunCommand {
+            command: format!(
+                "herdr workspace focus {ws_id} >/dev/null 2>&1; herdr tab focus {tab_id}"
+            ),
+            notify_success: false,
+            notify_error: true,
+        },
+        source_label: None,
+        // `ws_label` est deja dans le haystack via `workspace_label` : taper
+        // le nom du space fait donc remonter le space ET ses tabs.
+        search_terms: vec![tab_id.into(), name.to_string(), status.into()],
+        canonical: OnceLock::new(),
+    }
+}
+
+/// « [12] run » -> « run ». Laisse le texte intact s'il n'y a pas de prefixe.
+fn strip_index_prefix(label: &str) -> &str {
+    let rest = label.trim_start();
+    let Some(rest) = rest.strip_prefix('[') else {
+        return label.trim();
+    };
+    let Some((num, tail)) = rest.split_once(']') else {
+        return label.trim();
+    };
+    if num.is_empty() || !num.chars().all(|c| c.is_ascii_digit()) {
+        return label.trim();
+    }
+    let tail = tail.trim();
+    if tail.is_empty() { label.trim() } else { tail }
+}
