+
+    #[test]
+    fn single_tab_workspaces_get_no_children() {
+        let ws_json: Value = serde_json::from_str(
+            r#"{"result":{"workspaces":[
+                 {"workspace_id":"w1","label":"solo","tab_count":1,"pane_count":1,
+                  "agent_status":"idle","focused":false}]}}"#,
+        )
+        .unwrap();
+        let mut by_ws = HashMap::new();
+        by_ws.insert(
+            "w1".to_string(),
+            vec![serde_json::from_str::<Value>(
+                r#"{"tab_id":"w1:t1","workspace_id":"w1","label":"zsh","number":1,
+                    "pane_count":1,"agent_status":"idle","focused":true}"#,
+            )
+            .unwrap()],
+        );
+
+        // Seuil par defaut : 2. L'unique tab ferait doublon avec le space.
+        let (entries, _, _, _) = workspaces_from_json(
+            &ws_json,
+            &HashMap::new(),
+            &by_ws,
+            &mut NavigatorSnapshot::default(),
+            true,
+            2,
+        );
+        assert_eq!(entries.len(), 1);
+
+        // Seuil a 1 : on le montre quand meme.
+        let (entries, _, _, _) = workspaces_from_json(
+            &ws_json,
+            &HashMap::new(),
+            &by_ws,
+            &mut NavigatorSnapshot::default(),
+            true,
+            1,
+        );
+        assert_eq!(entries.len(), 2);
+    }
+
+    #[test]
+    fn index_prefix_is_stripped_only_when_it_is_one() {
+        assert_eq!(strip_index_prefix("[2] run"), "run");
+        assert_eq!(strip_index_prefix("  [12]  make dev "), "make dev");
+        assert_eq!(strip_index_prefix("run"), "run");
+        assert_eq!(strip_index_prefix("[wip] run"), "[wip] run");
+        assert_eq!(strip_index_prefix("[3]"), "[3]");
+    }
