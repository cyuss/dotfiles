+/// A CHILD row: a tab, under its space, in the `open` source.
+///
+/// It carries `Source::Workspace` to show up in the same section as the
+/// spaces (that's what the tree view needs) and `tab_id` so rendering
+/// and Ctrl-X know it's a tab and not a space.
+///
+/// The action goes through `RunCommand` instead of a dedicated variant:
+/// focus the space THEN the tab. Order matters, focusing the space after
+/// the tab would land on the space's active tab, not the chosen one.
+fn tab_entry(
+    t: &Value,
+    position: usize,
+    ws_id: &str,
+    ws_label: &str,
+    path: &Path,
+    last: bool,
+) -> Entry {
+    let tab_id = t.get("tab_id").and_then(|v| v.as_str()).unwrap_or("");
+    // Display POSITION, and definitely NOT the `number` field.
+    //
+    // `number` is a creation counter: it follows the tab_id ("wC:t4"
+    // -> 4) and keeps the gaps left by closed tabs. herdr numbers the
+    // tab bar by POSITION, so a space with a closed tab shows "[2]" on
+    // a tab whose `number` is 4.
+    //
+    // Showing "tab 4" was wrong twice: it doesn't match the tab bar,
+    // and `switch_tab = "prefix+1..9"` is an INDEXED binding, it
+    // targets the position. Reading "tab 4" and hitting prefix+4 went
+    // nowhere.
+    let panes = t.get("pane_count").and_then(|v| v.as_i64()).unwrap_or(1);
+    let status = t
+        .get("agent_status")
+        .and_then(|v| v.as_str())
+        .unwrap_or("unknown");
+    let focused = t.get("focused").and_then(|v| v.as_bool()).unwrap_or(false);
+    // herdr prefixes its labels with the display number ("[2] zsh");
+    // the number is already shown, so avoid "├ [2] zsh · tab 2".
+    let raw = t.get("label").and_then(|v| v.as_str()).unwrap_or("tab");
+    let name = strip_index_prefix(raw);
+    let branch = if last { "└" } else { "├" };
+
+    let mut meta = format!("tab {position}");
+    if panes > 1 {
+        meta.push_str(&format!(" · {panes} panes"));
+    }
+    if focused {
+        meta.push_str(" · courant");
+    }
+
+    Entry {
+        source: Source::Workspace,
+        tab_id: Some(tab_id.into()),
+        title: format!("  {branch} {name}"),
+        // Same shape as for a space: `entry_status` reads the `agent:`
+        // prefix and `entry_metadata` what follows the first ` · `.
+        subtitle: format!("agent:{status} · {meta}"),
+        path: path.to_path_buf(),
+        workspace_id: Some(ws_id.into()),
+        workspace_label: Some(ws_label.into()),
+        agent_target: None,
+        project: None,
+        action: EntryAction::RunCommand {
+            command: format!(
+                "herdr workspace focus {ws_id} >/dev/null 2>&1; herdr tab focus {tab_id}"
+            ),
+            notify_success: false,
+            notify_error: true,
+        },
+        source_label: None,
+        // `ws_label` is already in the haystack via `workspace_label`: typing
+        // the space name brings up the space AND its tabs.
+        search_terms: vec![tab_id.into(), name.to_string(), status.into()],
+        canonical: OnceLock::new(),
+    }
+}
+
+/// "[12] run" -> "run". Leaves the text alone if there's no prefix.
+fn strip_index_prefix(label: &str) -> &str {
+    let rest = label.trim_start();
+    let Some(rest) = rest.strip_prefix('[') else {
+        return label.trim();
+    };
+    let Some((num, tail)) = rest.split_once(']') else {
+        return label.trim();
+    };
+    if num.is_empty() || !num.chars().all(|c| c.is_ascii_digit()) {
+        return label.trim();
+    }
+    let tail = tail.trim();
+    if tail.is_empty() { label.trim() } else { tail }
+}
