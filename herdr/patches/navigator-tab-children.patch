+/// Le pane du picker tourne-t-il encore le navigator ?
+///
+/// C'est la question qui manquait. Quand le processus `ui` meurt sans que
+/// son pane soit ferme, herdr laisse un SHELL dans le pane — mais le pane
+/// garde son libelle « Herdr Navigator ». `picker_pane_decision` le
+/// retrouvait alors indefiniment et focalisait ce shell mort : prefix+w
+/// semblait ne plus rien faire, et il fallait la souris pour s'en sortir.
+///
+/// On interroge donc le processus au premier plan. Un pane dont le
+/// premier plan n'est pas le navigator est perime.
+fn picker_pane_is_live(pane_id: &str) -> bool {
+    let Ok(info) = herdr::herdr_json(["pane", "process-info", "--pane", pane_id]) else {
+        // Pas de reponse : on ne peut rien affirmer. On garde le
+        // comportement d'origine (focaliser) plutot que de fermer un pane
+        // peut-etre vivant.
+        return true;
+    };
+    let Some(procs) = info
+        .pointer("/result/process_info/foreground_processes")
+        .and_then(|v| v.as_array())
+    else {
+        return true;
+    };
+    procs.iter().any(|p| {
+        let name = p.get("name").and_then(|v| v.as_str()).unwrap_or("");
+        let cmd = p.get("cmdline").and_then(|v| v.as_str()).unwrap_or("");
+        name.contains("herdr-navigator") || cmd.contains("herdr-navigator")
+    })
+}
+
 fn open_picker() -> ! {
     let json = herdr::herdr_json(["pane", "list"]).unwrap_or(serde_json::Value::Null);
     match picker_pane_decision(&json) {
         PickerDecision::Open => open_plugin_pane("picker", &["--focus"]),
-        PickerDecision::Focus(id) => run_plugin_pane_cmd("focus", &id),
+        PickerDecision::Focus(id) => {
+            if picker_pane_is_live(&id) {
+                run_plugin_pane_cmd("focus", &id)
+            } else {
+                // Pane perime : on le ferme et on repart proprement, plutot
+                // que de laisser prefix+w inerte jusqu'a intervention
+                // manuelle.
+                //
+                // `pane close` et non `plugin pane close` : des que le
+                // processus du plugin meurt, herdr perd l'association
+                // plugin<->pane et `plugin pane close` repond
+                // `plugin_pane_not_found`. C'est justement le cas qu'on
+                // essaie de rattraper ici.
+                let _ = Command::new(herdr_bin())
+                    .args(["pane", "close", &id])
+                    .status();
+                open_plugin_pane("picker", &["--focus"])
+            }
+        }
     }
 }
 
