+/// Local patch: pane commands travel in the pane ENVIRONMENT
+/// (`HERDR_TAB_CMD`, set at creation with `--env`) and ~/.zshrc runs them
+/// before the first prompt. Upstream typed them with `herdr pane run`
+/// right after creation: the text raced the shell startup (ZLE not ready,
+/// oh-my-posh spinning at 100 % CPU) and the command stayed displayed but
+/// never ran.
+pub(crate) const TAB_CMD_ENV: &str = "HERDR_TAB_CMD";
+
+pub(crate) fn command_env_args(command: Option<&str>) -> Vec<String> {
+    match command.map(str::trim).filter(|command| !command.is_empty()) {
+        Some(command) => vec!["--env".into(), format!("{TAB_CMD_ENV}={command}")],
+        None => Vec::new(),
+    }
+}
+
+/// Command of the first pane of the first tab — the pane that
+/// `workspace create` spawns, so it must be passed there.
+pub(crate) fn first_pane_command(project: &Project) -> Option<String> {
+    project
+        .tabs
+        .first()
+        .and_then(|tab| tab.effective_panes().into_iter().next())
+        .and_then(|pane| pane.command)
+}
