<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Refreshes the $sync token on the herdr sidebar's space rows.
  Script: workflow-tools/herdr-space-metadata

  launchd doesn't follow symlinks reliably, so copy this file instead of
  linking it:

    install  cp herdr/launchd/local.herdr-space-metadata.plist ~/Library/LaunchAgents/
             launchctl bootstrap gui/$UID ~/Library/LaunchAgents/local.herdr-space-metadata.plist
    remove   launchctl bootout   gui/$UID/local.herdr-space-metadata
             rm ~/Library/LaunchAgents/local.herdr-space-metadata.plist
    status   launchctl print     gui/$UID/local.herdr-space-metadata

  launchd won't expand ~ or $HOME in ProgramArguments, so we go through
  /bin/sh, which does. No hardcoded home dir, works for any user.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.herdr-space-metadata</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>exec "$HOME/.config/workflow-tools/herdr-space-metadata" --watch 45</string>
	</array>

	<!-- launchd doesn't give you a login shell's PATH: without this,
	     neither `herdr` nor `git` is found. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<!-- The script loops and never exits on its own: KeepAlive only
	     restarts it if it gets killed. herdr server stopped = it sleeps,
	     it doesn't exit, so no restart loop. -->
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>

	<key>ProcessType</key>
	<string>Background</string>

	<key>StandardErrorPath</key>
	<string>/tmp/herdr-space-metadata.err</string>
</dict>
</plist>
