{
  "$schema": "https://opencode.ai/config.json",

  // ── Models ──────────────────────────────────────────────────────────
  // All local (Ollama). To add a cloud provider:
  //   opencode auth login   then   "model": "anthropic/claude-opus-5"
  "model": "ollama/qwen3-coder:30b",
  "small_model": "ollama/qwen2.5vl:7b",
  "default_agent": "build",

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": { "name": "Qwen3 Coder 30B — build" },
        "devstral:24b": { "name": "Devstral 24B — agentique" },
        "gpt-oss:120b": { "name": "GPT-OSS 120B — raisonnement" },
        "qwen3-coder:480b-cloud": { "name": "Qwen3 Coder 480B — cloud" },
        "qwen2.5vl:7b": { "name": "Qwen2.5-VL 7B — rapide / vision" }
      }
    }
  },

  // ── Agents ──────────────────────────────────────────────────────────
  // Dedicated subagents live in ~/.config/opencode/agent/*.md
  "agent": {
    "build": {
      "temperature": 0.1,
      "description": "Implémentation : édite, teste, itère."
    },
    "plan": {
      "model": "ollama/gpt-oss:120b",
      "temperature": 0.3,
      "description": "Analyse et conception, sans écrire de code."
    }
    // Subagents are defined in agent/*.md:
    //   reviewer (review)     scout (research)
    //   debugger (diagnosis)  tester (tests)
  },
  "subagent_depth": 1,

  // ── Skills ──────────────────────────────────────────────────────────
  // A skill = a skill/<name>/SKILL.md dir. opencode loads its description
  // at startup and only injects the body when the context matches, so it
  // costs zero tokens until it's used.
  // The ones here cover: python-uv, typescript-node, rust, go,
  // containers, data-science, shell.
  "skills": {
    "paths": ["~/.config/opencode/skill"]
  },

  // ── Context ─────────────────────────────────────────────────────────
  "instructions": [
    "~/.config/opencode/AGENTS.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "docs/architecture.md"
  ],

  // ── Tools: LSP + built-in formatters ────────────────────────────────
  // rust-analyzer, gopls, pyright, ruff, eslint... get picked up on their own.
  "lsp": true,
  "formatter": true,

  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/build/**",
      "**/target/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "**/.next/**",
      "**/coverage/**"
    ]
  },

  // ── Guardrails ──────────────────────────────────────────────────────
  // Read/edit freely, but ask before anything that leaves the repo or
  // destroys work.
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "edit": "allow",
    "webfetch": "allow",
    // Skills and opencode config live outside the current project:
    // without these rules every skill read triggers a prompt.
    "external_directory": {
      "*": "ask",
      "~/.config/opencode/**": "allow",
      "~/.agents/skills/**": "allow"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "ask",
      "rm -r *": "ask",
      "sudo *": "ask",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "git checkout -- *": "ask",
      "gh pr create*": "ask",
      "gh pr merge*": "ask",
      "npm publish*": "ask",
      "cargo publish*": "ask",
      "docker system prune*": "ask",
      "kubectl delete*": "ask",
      "terraform apply*": "ask",
      "terraform destroy*": "ask",
      "brew uninstall*": "ask",
      "curl * | sh": "ask",
      "curl * | bash": "ask"
    }
  },

  // ── Session / context ───────────────────────────────────────────────
  "share": "disabled",
  "autoupdate": "notify",
  "snapshot": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "tool_output": {
    "max_lines": 1200,
    "max_bytes": 40960
  },
  "experimental": {
    "batch_tool": true
  }

  // ── MCP (example, uncomment if needed) ──────────────────────────────
  // "mcp": {
  //   "github": {
  //     "type": "local",
  //     "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
  //     "enabled": true,
  //     "environment": { "GITHUB_TOKEN": "{env:GITHUB_TOKEN}" }
  //   }
  // }
}
