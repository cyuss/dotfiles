{
  "$schema": "https://opencode.ai/config.json",

  // ── Modèles ─────────────────────────────────────────────────────────
  // Tout est local (Ollama). Pour ajouter un provider cloud :
  //   opencode auth login   puis   "model": "anthropic/claude-opus-5"
  "model": "ollama/qwen3-coder:30b",
  "small_model": "ollama/qwen2.5vl:7b",
  "default_agent": "build",
  "username": "youcef",

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": { "name": "Qwen3 Coder 30B — build" },
        "devstral:24b": { "name": "Devstral 24B — agentique" },
        "gpt-oss:120b": { "name": "GPT-OSS 120B — raisonnement" },
        "qwen3-coder:480b-cloud": { "name": "Qwen3 Coder 480B — cloud" },
        "qwen2.5vl:7b": { "name": "Qwen2.5-VL 7B — rapide / vision" }
      }
    }
  },

  // ── Agents ──────────────────────────────────────────────────────────
  // Les subagents dédiés vivent dans ~/.config/opencode/agent/*.md
  "agent": {
    "build": {
      "temperature": 0.1,
      "description": "Implémentation : édite, teste, itère."
    },
    "plan": {
      "model": "ollama/gpt-oss:120b",
      "temperature": 0.3,
      "description": "Analyse et conception, sans écrire de code."
    }
    // Les subagents sont definis dans agent/*.md :
    //   reviewer (relecture)  scout (recherche)
    //   debugger (diagnostic) tester (tests)
  },
  "subagent_depth": 1,

  // ── Skills ──────────────────────────────────────────────────────────
  // Un skill = un dossier skill/<nom>/SKILL.md. opencode charge sa
  // description au demarrage et n'injecte le corps QUE si le contexte
  // correspond : le cout en tokens reste nul tant qu'il ne sert pas.
  // Ceux d'ici couvrent : python-uv, typescript-node, rust, go,
  // containers, data-science, shell.
  "skills": {
    "paths": ["~/.config/opencode/skill"]
  },

  // ── Contexte ────────────────────────────────────────────────────────
  "instructions": [
    "~/.config/opencode/AGENTS.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "docs/architecture.md"
  ],

  // ── Outils : LSP + formatters natifs ────────────────────────────────
  // rust-analyzer, gopls, pyright, ruff, eslint… sont détectés seuls.
  "lsp": true,
  "formatter": true,

  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/build/**",
      "**/target/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "**/.next/**",
      "**/coverage/**"
    ]
  },

  // ── Garde-fous ──────────────────────────────────────────────────────
  // Lecture/édition libres, mais confirmation sur tout ce qui sort du
  // repo ou détruit du travail.
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "edit": "allow",
    "webfetch": "allow",
    // Les skills et la config d'opencode vivent hors du projet courant :
    // sans ces regles, chaque lecture de skill declenche une demande.
    "external_directory": {
      "*": "ask",
      "/Users/youcef/.config/opencode/**": "allow",
      "/Users/youcef/.agents/skills/**": "allow"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "ask",
      "rm -r *": "ask",
      "sudo *": "ask",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "git checkout -- *": "ask",
      "gh pr create*": "ask",
      "gh pr merge*": "ask",
      "npm publish*": "ask",
      "cargo publish*": "ask",
      "docker system prune*": "ask",
      "kubectl delete*": "ask",
      "terraform apply*": "ask",
      "terraform destroy*": "ask",
      "brew uninstall*": "ask",
      "curl * | sh": "ask",
      "curl * | bash": "ask"
    }
  },

  // ── Session / contexte ──────────────────────────────────────────────
  "share": "disabled",
  "autoupdate": "notify",
  "snapshot": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "tool_output": {
    "max_lines": 1200,
    "max_bytes": 40960
  },
  "experimental": {
    "batch_tool": true
  }

  // ── MCP (exemple, décommenter au besoin) ────────────────────────────
  // "mcp": {
  //   "github": {
  //     "type": "local",
  //     "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
  //     "enabled": true,
  //     "environment": { "GITHUB_TOKEN": "{env:GITHUB_TOKEN}" }
  //   }
  // }
}
