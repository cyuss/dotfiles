{
  "$schema": "https://opencode.ai/tui.json",

  // "system" = opencode uses the terminal's 16 colors.
  // So it matches the Alacritty theme (premium-noir) exactly.
  "theme": "system",

  // ── Readability ─────────────────────────────────────────────────────
  "diff_style": "auto",
  "scroll_speed": 3,
  "scroll_acceleration": { "enabled": true },
  "mouse": true,
  "cursor": {
    "style": "default",
    "blinking": false
  },
  "prompt": {
    "max_height": 20,
    "max_width": "auto"
  },

  // ── Notify me when the agent needs me ───────────────────────────────
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.35
  },

  // ── Keyboard ────────────────────────────────────────────────────────
  "leader_timeout": 800,
  "keybinds": {
    "leader": "ctrl+x",

    // Newline without sending. All 3 forms are accepted:
    // Alacritty sends ESC+CR (= alt+enter) on ⇧⏎ and ⌘⏎, and ctrl+j is
    // the universal fallback (tmux, SSH, terminals without kitty protocol).
    "input_newline": ["shift+enter", "alt+enter", "ctrl+j"],

    // readline / macOS style prompt editing
    "input_line_home": ["ctrl+a", "home"],
    "input_line_end": ["ctrl+e", "end"],
    "input_word_backward": ["alt+arrowleft", "alt+b"],
    "input_word_forward": ["alt+arrowright", "alt+f"],
    "input_delete_word_backward": ["ctrl+w", "alt+backspace"],
    "input_delete_to_line_start": "ctrl+u",
    "input_delete_to_line_end": "ctrl+k"
  }
}
